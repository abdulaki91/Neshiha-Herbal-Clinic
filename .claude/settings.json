{
  "permissions": {
    "allow": [
      "Bash(node -e ' *)",
      "Bash(timeout 15 node src/server.js)",
      "Bash(nohup node src/server.js)",
      "Bash(echo \"PID:$!\")",
      "Read(//tmp/**)",
      "Bash(sleep 3 && tail -40 /tmp/server-boot.log)",
      "Bash(rm -f /tmp/server-boot.log)",
      "Bash(curl -s -o /dev/null -w \"port 5000 status: %{http_code}\\\\n\" http://localhost:5000/health --max-time 3)",
      "Bash(npx eslint *)",
      "Bash(node _tmp_test_settings.mjs)",
      "Bash(node _tmp_test_testimonial.mjs)",
      "Bash(node _tmp_test_all_cms.mjs)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5000/api/v1/public/testimonials)",
      "Bash(curl -s http://localhost:5000/api/v1/public/site-info)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5000/api/v1/testimonials)",
      "Bash(curl -s -o /dev/null -w \"health check: %{http_code}\\\\n\" http://localhost:5000/health --max-time 3)",
      "Bash(curl -s -o /dev/null -w \"health: %{http_code}\\\\n\" http://localhost:5000/health --max-time 3)",
      "Bash(tail -50 /tmp/server-verify.log)",
      "Bash(curl -s -o /dev/null -w \"health: %{http_code}\\\\n\" http://localhost:5000/health --max-time 5)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5000/api/v1/public/testimonials --max-time 5)",
      "Bash(curl -s http://localhost:5000/api/v1/public/site-info --max-time 5)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5000/api/v1/testimonials --max-time 5)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5000/api/v1/faqs --max-time 5)",
      "PowerShell(Get-Process -Id 3792 -ErrorAction SilentlyContinue)",
      "Bash(curl -s -D - -o /dev/null -H \"Origin: https://nesihaherbalclinic.abdulaki.com\" http://localhost:5000/api/v1/public/testimonials --max-time 5)",
      "Bash(pkill -f \"node src/server.js\")"
    ]
  }
}
