# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neshiha_clinic
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@neshihaclinic.com

# Allowed CORS origins (app.js, config/socket.js) — comma-separated if you
# need more than one (e.g. an apex + www variant). In production, set this
# on the host to your deployed frontend's real origin(s), e.g.
# ALLOWED_ORIGINS=https://nesihaherbalclinic.abdulaki.com
# Local dev (http://localhost:5173/5174) is always allowed on top of this,
# so you never need to list it yourself.
ALLOWED_ORIGINS=

# Deprecated: still read as a single-origin fallback if ALLOWED_ORIGINS
# isn't set. Prefer ALLOWED_ORIGINS above.
FRONTEND_URL=http://localhost:5173

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Session
SESSION_SECRET=your_session_secret_change_this
