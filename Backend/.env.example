# Server Configuration
NODE_ENV=production
PORT=5000
API_VERSION=v1
# ssh -L 5434:localhost:5432 -p 1219 abdulaki@abdulaki.com

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=abdulaki_nashiha_clinic
DB_USER=abdulaki_abdulaki
DB_PASSWORD="Alhamdulillaah##91"
DB_DIALECT=postgres

# JWT Configuration
JWT_SECRET=neshiha_clinic_super_secret_jwt_key_2024_change_in_production
JWT_REFRESH_SECRET=neshiha_refresh_token_secret_2024_change_in_production
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@neshihaclinic.com

# Allowed CORS origins (comma-separated) — see .env.example. Empty here
# since local dev's localhost:5173/5174 are always allowed regardless.
ALLOWED_ORIGINS=https://nesihaherbalclinic-backend.abdulaki.com,https://www.nesihaherbalclinic-backend.abdulaki.com,https://nesihaherbalclinic.abdulaki.com
FRONTEND_URL=http://localhost:5173

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Session
SESSION_SECRET=neshiha_session_secret_change_this
